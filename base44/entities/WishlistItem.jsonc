{
  "name": "WishlistItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "price": {
      "type": "string",
      "title": "Price"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL",
      "format": "uri"
    },
    "source_url": {
      "type": "string",
      "title": "Source URL",
      "format": "uri"
    },
    "category": {
      "type": "array",
      "title": "Tags",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "bought": {
      "type": "boolean",
      "title": "Bought",
      "default": false
    }
  },
  "required": [
    "title",
    "source_url"
  ]
}